PORT=5000
JWT_SECRET=supersecretkey_change_me

# Either provide a full connection string...
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobportal

# ...or, if you prefer, individual settings are also read as a fallback
# when DATABASE_URL is not set:
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=1234
PGDATABASE=job_portal

